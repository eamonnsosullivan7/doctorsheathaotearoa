---
import {Image} from 'astro:assets'
import bookIcon from '../assets/icons/book-open-solid-full.svg'
import peopleIcon from '../assets/icons/people-group-solid-full.svg'
import seedlingIcon from '../assets/icons/seedling-solid-full.svg'
import missionDiagram from '../assets/images/CircleSplit_BLUE_reworked.png'
import heroImage from '../assets/images/dhashero-1.jpeg'
import EventList from '../components/EventList.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import {getEvents} from '../sanity/lib/queries'

const events = await getEvents(4)

// Each pillar's `wedge` is its ring segment in the supplied diagram, in a
// 200×200 viewBox: the image splits at 0°, 120° and 240°, and its white centre
// is 59% of the diameter. The wedges sit invisibly over the image to link and
// highlight each segment without altering the artwork.
const pillars = [
  {
    id: 'connections',
    title: 'Connections',
    text: 'A central hub linking doctors with the support they need, and amplifying organisations that support and research doctor health and wellbeing.',
    wedge: 'M13.4 150 A100 100 0 0 1 100 0 L100 41 A59 59 0 0 0 48.9 129.5 Z',
  },
  {
    id: 'advocacy',
    title: 'Advocacy',
    text: 'An authoritative voice on doctor and medical student wellbeing, shaping policy and pushing for systemic change with media, regulators and professional bodies.',
    wedge: 'M100 0 A100 100 0 0 1 186.6 150 L151.1 129.5 A59 59 0 0 0 100 41 Z',
  },
  {
    id: 'education',
    title: 'Education',
    text: 'Promoting training on being a doctor for doctors, substance use, holistic wellbeing and sustainable careers, adapting proven international models for Aotearoa.',
    wedge: 'M186.6 150 A100 100 0 0 1 13.4 150 L48.9 129.5 A59 59 0 0 0 151.1 129.5 Z',
  },
]

const supportAreas = [
  {
    icon: peopleIcon,
    title: 'Support for you and your colleagues',
    text: 'Confidential, compassionate support for doctors and medical students facing personal, professional, or health challenges.',
    href: '/support#support-for-you-and-your-colleagues',
  },
  {
    icon: seedlingIcon,
    title: 'Get involved in supporting doctors',
    text: 'Join our network of doctors helping doctors. Volunteer for the roster, offer services, or contribute your expertise.',
    href: '/support#get-involved',
  },
  {
    icon: bookIcon,
    title: 'Voices from the medical community',
    text: 'Explore insights, interviews, and stories from doctors supporting doctors.',
    href: '/support#articles-podcasts-books',
  },
]

const organisationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Doctors Health Aotearoa',
  description:
    'Empowering doctor health and wellbeing through connections, education, advocacy - for the good of all New Zealanders',
  url: Astro.site?.href,
}
---

<BaseLayout transparentHeader jsonLd={organisationJsonLd}>
  <section class="home-hero">
    <Image
      class="home-hero__image"
      src={heroImage}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container home-hero__content">
      <p class="eyebrow">Welcome</p>
      <h1 class="home-hero__title">Doctors Health Aotearoa</h1>
      <p class="home-hero__lead">
        Empowering doctor health and wellbeing through connections, education, advocacy - for the good of all New
        Zealanders
      </p>
    </div>
  </section>

  <section class="section mission" aria-labelledby="mission-title">
    <div class="container">
      <h2 class="mission__title" id="mission-title">Our Mission</h2>
      <div class="mission__layout" data-mission>
        <div class="mission__diagram">
          <Image
            class="mission__image"
            src={missionDiagram}
            alt="Diagram of the DHA values: Connections, Advocacy and Education, around the words Healthy Doctors, Sustainable Work, Safe Workplaces"
            widths={[320, 440, 640, 880]}
            sizes="(max-width: 699px) min(320px, 80vw), (max-width: 999px) 380px, 440px"
          />
          <svg class="mission__wedges" viewBox="0 0 200 200" aria-label="Our pillars">
            {
              pillars.map((pillar) => (
                <a href={`/about#${pillar.id}`} aria-label={`${pillar.title}: our objectives`} data-pillar={pillar.id}>
                  <path class="mission__wedge" d={pillar.wedge} />
                </a>
              ))
            }
          </svg>
        </div>
        {
          pillars.map((pillar) => (
            <div class={`mission__pillar mission__pillar--${pillar.id}`} data-pillar={pillar.id} data-reveal>
              <h3 class="mission__pillar-title">
                <span class="mission__marker" aria-hidden="true" />
                {pillar.title}
              </h3>
              <p class="mission__pillar-text">{pillar.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="events-title">
    <div class="container">
      <div class="home-events__header">
        <h2 class="home-events__title" id="events-title">Events</h2>
        <a class="link-arrow" href="/events">View all</a>
      </div>
      <EventList events={events} />
      <p class="home-events__cta">
        Got an event you would like to list? <a href="/events#list-an-event">Tell us about it here!</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="support-title">
    <div class="container">
      <h2 class="support-teaser__title" id="support-title">How We Support the Medical Community</h2>
      <p class="support-teaser__intro">
        There are many support services and online resources that doctors and medical students can access for any level
        of support you or your colleagues may need.
      </p>
      <ul class="support-teaser__list" role="list">
        {
          supportAreas.map((area) => (
            <li class="support-teaser__item" data-reveal>
              <Image class="support-teaser__icon" src={area.icon} alt="" width={40} height={40} />
              <h3 class="support-teaser__item-title">
                <a class="support-teaser__link" href={area.href}>
                  {area.title}
                </a>
              </h3>
              <p>{area.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="support-teaser__more"><a class="link-arrow" href="/support">Learn more</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  // Highlight a pillar's segment while its text or wedge is hovered or focused.
  const layout = document.querySelector<HTMLElement>('[data-mission]')
  if (layout) {
    const pillars = layout.querySelectorAll<HTMLElement | SVGElement>('[data-pillar]')

    const setActive = (id?: string) => {
      if (id) layout.dataset.active = id
      else delete layout.dataset.active
      layout.querySelectorAll('.mission__pillar').forEach((pillar) => {
        pillar.classList.toggle('is-active', (pillar as HTMLElement).dataset.pillar === id)
      })
    }

    pillars.forEach((element) => {
      const id = element.dataset.pillar
      element.addEventListener('pointerenter', () => setActive(id))
      element.addEventListener('pointerleave', () => setActive())
      element.addEventListener('focusin', () => setActive(id))
      element.addEventListener('focusout', () => setActive())
    })
  }
</script>

<style>
  /* Hero */
  .home-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 80svh;
    padding-block: calc(var(--header-height) + var(--space-l)) var(--space-3xl);
    overflow: hidden;
    color: var(--color-text-inverse);
  }

  .home-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(93deg, rgb(0 0 0 / 70%) 24%, transparent);
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
  }

  .home-hero__content > * {
    max-width: 36rem;
  }

  .home-hero__title {
    margin-block: var(--space-s);
    color: var(--color-brand);
    font-weight: 800;
  }

  .home-hero__lead {
    font-size: 1.5rem;
  }

  /* Mission: each pillar sits beside its segment of the diagram */
  .mission__title {
    margin-bottom: var(--space-l);
  }

  .mission__layout {
    --pillar-connections: var(--color-brand);
    --pillar-advocacy: var(--color-brand-dark);
    --pillar-education: #3b87bc;

    display: grid;
    grid-template-areas:
      'connections diagram advocacy'
      '. education .';
    grid-template-columns: minmax(0, 1fr) minmax(320px, 440px) minmax(0, 1fr);
    column-gap: var(--space-xl);
    row-gap: var(--space-m);
  }

  .mission__diagram {
    position: relative;
    grid-area: diagram;
  }

  .mission__image {
    width: 100%;
  }

  .mission__wedges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Wedges are invisible until a pillar is active; then the others fade back. */
  .mission__wedge {
    fill: #fff;
    fill-opacity: 0;
    transition: fill-opacity 0.25s ease;
  }

  .mission__layout[data-active] .mission__wedge {
    fill-opacity: 0.55;
  }

  .mission__layout[data-active='connections'] [data-pillar='connections'] .mission__wedge,
  .mission__layout[data-active='advocacy'] [data-pillar='advocacy'] .mission__wedge,
  .mission__layout[data-active='education'] [data-pillar='education'] .mission__wedge {
    fill-opacity: 0;
  }

  .mission__wedges a:focus-visible {
    outline: none;
  }

  .mission__wedges a:focus-visible .mission__wedge {
    stroke: var(--color-focus);
    stroke-width: 1.5;
  }

  .mission__pillar {
    max-width: 22rem;
    transition: opacity 0.25s ease;
  }

  .mission__layout[data-active] .mission__pillar:not([data-pillar].is-active) {
    opacity: 0.45;
  }

  /* Connections and Advocacy sit level with their segments' midpoints, in the upper third. */
  .mission__pillar--connections {
    grid-area: connections;
    align-self: start;
    justify-self: end;
    margin-top: 18%;
    text-align: right;
  }

  .mission__pillar--advocacy {
    grid-area: advocacy;
    align-self: start;
    margin-top: 18%;
  }

  .mission__pillar--education {
    grid-area: education;
    justify-self: center;
    text-align: center;
  }

  .mission__pillar-title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
    color: var(--color-brand-dark);
    font-size: 1.25rem;
  }

  .mission__pillar--connections .mission__pillar-title {
    flex-direction: row-reverse;
  }

  .mission__pillar--education .mission__pillar-title {
    justify-content: center;
  }

  .mission__marker {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }

  .mission__pillar--connections .mission__marker {
    background: var(--pillar-connections);
  }

  .mission__pillar--advocacy .mission__marker {
    background: var(--pillar-advocacy);
  }

  .mission__pillar--education .mission__marker {
    background: var(--pillar-education);
  }

  /* Tablet: diagram on top, the three pillars in a row beneath it. */
  @media (max-width: 999px) {
    .mission__layout {
      grid-template-areas:
        'diagram diagram diagram'
        'connections advocacy education';
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-m);
    }

    .mission__diagram {
      justify-self: center;
      width: min(380px, 100%);
      margin-bottom: var(--space-s);
    }

    .mission__pillar,
    .mission__pillar--connections,
    .mission__pillar--advocacy,
    .mission__pillar--education {
      align-self: start;
      justify-self: stretch;
      max-width: none;
      margin-top: 0;
      text-align: left;
    }

    .mission__pillar--connections .mission__pillar-title {
      flex-direction: row;
    }

    .mission__pillar--education .mission__pillar-title {
      justify-content: flex-start;
    }
  }

  /* Phone: everything stacks. */
  @media (max-width: 699px) {
    .mission__layout {
      grid-template-areas: 'diagram' 'connections' 'advocacy' 'education';
      grid-template-columns: minmax(0, 1fr);
    }

    .mission__diagram {
      width: min(320px, 80vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission__wedge,
    .mission__pillar {
      transition: none;
    }
  }

  /* Events */
  .home-events__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  .home-events__title {
    color: var(--color-brand-dark);
  }

  .home-events__cta {
    margin-top: var(--space-l);
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
  }

  /* Support teaser */
  .support-teaser__title {
    margin-bottom: var(--space-m);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .support-teaser__intro {
    max-width: 48rem;
  }

  .support-teaser__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-m);
    margin: var(--space-l) 0;
    padding: 0;
    list-style: none;
  }

  .support-teaser__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-m) var(--space-s);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-align: center;
    transition: transform 0.2s ease;
  }

  .support-teaser__item:hover {
    transform: translateY(-4px);
  }

  .support-teaser__icon {
    width: 40px;
    height: 40px;
  }

  .support-teaser__item-title {
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .support-teaser__link {
    color: inherit;
    text-decoration: none;
  }

  .support-teaser__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .support-teaser__more {
    font-size: 1.25rem;
    text-align: right;
  }
</style>
