---
import {Image} from 'astro:assets'
import missionDiagram from '../assets/images/CircleSplit_BLUE_reworked.png'
import heroImage from '../assets/images/dhashero-1.jpeg'
import CategoryIcon from '../components/support/CategoryIcon.astro'
import UpcomingEvents from '../components/UpcomingEvents.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import {splitEvents} from '../lib/events'
import {getEvents, getSupportOverview} from '../sanity/lib/queries'

const [events, supportCategories] = await Promise.all([getEvents(), getSupportOverview()])
// The homepage shows at most the next three upcoming events.
const upcomingEvents = splitEvents(events).upcoming.slice(0, 3)

// Each pillar's `wedge` is its ring segment in the supplied diagram, in a
// 200×200 viewBox: the image splits at 0°, 120° and 240°, and its white centre
// is 59% of the diameter. The wedges sit invisibly over the image to link and
// highlight each segment without altering the artwork.
const pillars = [
  {
    id: 'connections',
    title: 'Connections',
    text: 'A central hub linking doctors with the support they need, and amplifying organisations that support and research doctor health and wellbeing.',
    wedge: 'M13.4 150 A100 100 0 0 1 100 0 L100 41 A59 59 0 0 0 48.9 129.5 Z',
  },
  {
    id: 'advocacy',
    title: 'Advocacy',
    text: 'An authoritative voice on doctor and medical student wellbeing, shaping policy and pushing for systemic change with media, regulators and professional bodies.',
    wedge: 'M100 0 A100 100 0 0 1 186.6 150 L151.1 129.5 A59 59 0 0 0 100 41 Z',
  },
  {
    id: 'education',
    title: 'Education',
    text: 'Promoting training on being a doctor for doctors, substance use, holistic wellbeing and sustainable careers, adapting proven international models for Aotearoa.',
    wedge: 'M186.6 150 A100 100 0 0 1 13.4 150 L48.9 129.5 A59 59 0 0 0 151.1 129.5 Z',
  },
]

const organisationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Doctors Health Aotearoa',
  description:
    'Empowering doctor health and wellbeing through connections, education, advocacy - for the good of all New Zealanders',
  url: Astro.site?.href,
}
---

<BaseLayout transparentHeader jsonLd={organisationJsonLd}>
  <section class="home-hero">
    <Image
      class="home-hero__image"
      src={heroImage}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container home-hero__content">
      <p class="eyebrow">Welcome</p>
      <h1 class="home-hero__title">Doctors Health Aotearoa</h1>
      <p class="home-hero__lead">
        Empowering doctor health and wellbeing through connections, education, advocacy - for the good of all New
        Zealanders
      </p>
    </div>
  </section>

  <section class="section mission" aria-labelledby="mission-title">
    <div class="container">
      <h2 class="mission__title" id="mission-title">Our Mission</h2>
      <div class="mission__layout" data-mission>
        <div class="mission__diagram">
          <Image
            class="mission__image"
            src={missionDiagram}
            alt="Diagram of the DHA values: Connections, Advocacy and Education, around the words Healthy Doctors, Sustainable Work, Safe Workplaces"
            widths={[320, 440, 640, 880]}
            sizes="(max-width: 699px) min(320px, 80vw), (max-width: 999px) 380px, 440px"
          />
          <svg class="mission__wedges" viewBox="0 0 200 200" aria-label="Our pillars">
            {
              pillars.map((pillar) => (
                <a href={`/about#${pillar.id}`} aria-label={`${pillar.title}: our objectives`} data-pillar={pillar.id}>
                  <path class="mission__wedge" d={pillar.wedge} />
                </a>
              ))
            }
          </svg>
        </div>
        {
          pillars.map((pillar) => (
            <div class={`mission__pillar mission__pillar--${pillar.id}`} data-pillar={pillar.id} data-reveal>
              <h3 class="mission__pillar-title">
                <span class="mission__marker" aria-hidden="true" />
                {pillar.title}
              </h3>
              <p class="mission__pillar-text">{pillar.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="events-title">
    <div class="container">
      <div class="home-events__header">
        <h2 class="home-events__title" id="events-title">Upcoming events</h2>
        <a class="link-arrow" href="/events">All events</a>
      </div>
      <UpcomingEvents events={upcomingEvents}>
        <p class="home-events__past" slot="empty">
          <a href="/events#past-events">Browse past events</a>
        </p>
      </UpcomingEvents>
      <p class="home-events__cta">
        Got an event you would like to list? <a href="/events#list-an-event">Tell us about it here!</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="support-title">
    <div class="container">
      <h2 class="support-overview__title" id="support-title">How We Support the Medical Community</h2>
      <p class="support-overview__intro">
        There are many support services and online resources that doctors and medical students can access for any level
        of support you or your colleagues may need.
      </p>
      <ul class="support-overview__list" role="list">
        {
          supportCategories.map((category) => {
            const remaining = category.resourceCount - category.preview.length
            return (
              <li class="support-card" data-reveal>
                <CategoryIcon icon={category.icon} />
                <h3 class="support-card__title">
                  <a class="support-card__link" href={`/support#${category.slug}`}>
                    {category.title}
                  </a>
                </h3>
                {/* Intro and preview always render so the subgrid rows stay aligned. */}
                <p class="support-card__intro">{category.intro}</p>
                <div class="support-card__preview">
                  {category.preview.length > 0 && (
                    <>
                      <p class="support-card__preview-label">Includes</p>
                      <ul class="support-card__preview-list">
                        {category.preview.map((title) => (
                          <li class="support-card__preview-item">{title}</li>
                        ))}
                      </ul>
                      {remaining > 0 && <p class="support-card__more">and {remaining} more</p>}
                    </>
                  )}
                </div>
                <p class="support-card__cta" aria-hidden="true">
                  Explore
                  <svg class="support-card__arrow" viewBox="0 0 24 24">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </p>
              </li>
            )
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // Highlight a pillar's segment while its text or wedge is hovered or focused.
  const layout = document.querySelector<HTMLElement>('[data-mission]')
  if (layout) {
    const pillars = layout.querySelectorAll<HTMLElement | SVGElement>('[data-pillar]')

    const setActive = (id?: string) => {
      if (id) layout.dataset.active = id
      else delete layout.dataset.active
      layout.querySelectorAll('.mission__pillar').forEach((pillar) => {
        pillar.classList.toggle('is-active', (pillar as HTMLElement).dataset.pillar === id)
      })
    }

    pillars.forEach((element) => {
      const id = element.dataset.pillar
      element.addEventListener('pointerenter', () => setActive(id))
      element.addEventListener('pointerleave', () => setActive())
      element.addEventListener('focusin', () => setActive(id))
      element.addEventListener('focusout', () => setActive())
    })
  }
</script>

<style>
  /* Hero */
  .home-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 80svh;
    padding-block: calc(var(--header-height) + var(--space-l)) var(--space-3xl);
    overflow: hidden;
    color: var(--color-text-inverse);
  }

  .home-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(93deg, rgb(0 0 0 / 70%) 24%, transparent);
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
  }

  .home-hero__content > * {
    max-width: 36rem;
  }

  .home-hero__title {
    margin-block: var(--space-s);
    color: var(--color-brand);
    font-weight: 800;
  }

  .home-hero__lead {
    font-size: 1.5rem;
  }

  /* Mission: each pillar sits beside its segment of the diagram */
  .mission__title {
    margin-bottom: var(--space-l);
  }

  .mission__layout {
    display: grid;
    grid-template-areas:
      'connections diagram advocacy'
      '. education .';
    grid-template-columns: minmax(0, 1fr) minmax(320px, 440px) minmax(0, 1fr);
    column-gap: var(--space-xl);
    row-gap: var(--space-m);
  }

  .mission__diagram {
    position: relative;
    grid-area: diagram;
  }

  .mission__image {
    width: 100%;
  }

  .mission__wedges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Wedges are invisible until a pillar is active; then the others fade back. */
  .mission__wedge {
    fill: #fff;
    fill-opacity: 0;
    transition: fill-opacity 0.25s ease;
  }

  .mission__layout[data-active] .mission__wedge {
    fill-opacity: 0.55;
  }

  .mission__layout[data-active='connections'] [data-pillar='connections'] .mission__wedge,
  .mission__layout[data-active='advocacy'] [data-pillar='advocacy'] .mission__wedge,
  .mission__layout[data-active='education'] [data-pillar='education'] .mission__wedge {
    fill-opacity: 0;
  }

  .mission__wedges a:focus-visible {
    outline: none;
  }

  .mission__wedges a:focus-visible .mission__wedge {
    stroke: var(--color-focus);
    stroke-width: 1.5;
  }

  .mission__pillar {
    max-width: 22rem;
    transition: opacity 0.25s ease;
  }

  .mission__layout[data-active] .mission__pillar:not([data-pillar].is-active) {
    opacity: 0.45;
  }

  /* Connections and Advocacy sit level with their segments' midpoints, in the upper third. */
  .mission__pillar--connections {
    grid-area: connections;
    align-self: start;
    justify-self: end;
    margin-top: 18%;
    text-align: right;
  }

  .mission__pillar--advocacy {
    grid-area: advocacy;
    align-self: start;
    margin-top: 18%;
  }

  .mission__pillar--education {
    grid-area: education;
    justify-self: center;
    text-align: center;
  }

  .mission__pillar-title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
    color: var(--color-brand-dark);
    font-size: 1.25rem;
  }

  .mission__pillar--connections .mission__pillar-title {
    flex-direction: row-reverse;
  }

  .mission__pillar--education .mission__pillar-title {
    justify-content: center;
  }

  .mission__marker {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }

  .mission__pillar--connections .mission__marker {
    background: var(--color-pillar-connections);
  }

  .mission__pillar--advocacy .mission__marker {
    background: var(--color-pillar-advocacy);
  }

  .mission__pillar--education .mission__marker {
    background: var(--color-pillar-education);
  }

  /* Tablet: diagram on top, the three pillars in a row beneath it. */
  @media (max-width: 999px) {
    .mission__layout {
      grid-template-areas:
        'diagram diagram diagram'
        'connections advocacy education';
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-m);
    }

    .mission__diagram {
      justify-self: center;
      width: min(380px, 100%);
      margin-bottom: var(--space-s);
    }

    .mission__pillar,
    .mission__pillar--connections,
    .mission__pillar--advocacy,
    .mission__pillar--education {
      align-self: start;
      justify-self: stretch;
      max-width: none;
      margin-top: 0;
      text-align: left;
    }

    .mission__pillar--connections .mission__pillar-title {
      flex-direction: row;
    }

    .mission__pillar--education .mission__pillar-title {
      justify-content: flex-start;
    }
  }

  /* Phone: everything stacks. */
  @media (max-width: 699px) {
    .mission__layout {
      grid-template-areas: 'diagram' 'connections' 'advocacy' 'education';
      grid-template-columns: minmax(0, 1fr);
    }

    .mission__diagram {
      width: min(320px, 80vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission__wedge,
    .mission__pillar {
      transition: none;
    }
  }

  /* Events */
  .home-events__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  .home-events__title {
    color: var(--color-brand-dark);
  }

  .home-events__past {
    margin-top: var(--space-m);
  }

  .home-events__cta {
    margin-top: var(--space-l);
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
  }

  /* Support overview: one card per support page category */
  .support-overview__title {
    margin-bottom: var(--space-m);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .support-overview__intro {
    max-width: 48rem;
  }

  .support-overview__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-m);
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Subgrid lines up each row (icon, title, intro, preview, link) across the cards. */
  .support-card {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease;
  }

  .support-card:hover {
    transform: translateY(-4px);
  }

  .support-card:has(.support-card__link:focus-visible) {
    outline: 0.125rem solid var(--color-focus);
    outline-offset: 0.125rem;
  }

  .support-card > :global(.category-icon) {
    justify-self: start;
  }

  .support-card__title {
    color: var(--color-brand-dark);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .support-card__link {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is clickable via the title link. */
  .support-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .support-card__link:focus-visible {
    outline: none;
  }

  .support-card__intro {
    color: var(--color-text-muted);
  }

  .support-card__preview {
    align-self: start;
    width: 100%;
    font-size: 0.875rem;
  }

  .support-card__preview:not(:empty) {
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
  }

  .support-card__preview-label {
    margin-bottom: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .support-card__preview-list {
    margin: 0;
    padding-left: 1.1em;
  }

  .support-card__preview-item {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .support-card__preview-item::marker {
    color: var(--color-brand);
  }

  .support-card__more {
    margin-top: var(--space-2xs);
    color: var(--color-text-muted);
  }

  .support-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    align-self: end;
    justify-self: start;
    padding-top: var(--space-xs);
    color: var(--color-brand-dark);
    font-weight: 600;
  }

  .support-card__arrow {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .support-card:hover .support-card__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .support-card,
    .support-card__arrow {
      transition: none;
    }

    .support-card:hover,
    .support-card:hover .support-card__arrow {
      transform: none;
    }
  }
</style>
