---
import type {GetStaticPaths} from 'astro'
import EventList from '../../components/EventList.astro'
import RichText from '../../components/RichText.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {calendarFileUrl} from '../../lib/calendar'
import {formatDateRange, isPast} from '../../lib/dates'
import {splitEvents} from '../../lib/events'
import {srcSet, urlFor} from '../../sanity/lib/image'
import {type Event, type EventSummary, getEvents, getEventsWithContent} from '../../sanity/lib/queries'

export const getStaticPaths = (async () => {
  const [events, summaries] = await Promise.all([getEventsWithContent(), getEvents()])
  const {upcoming} = splitEvents(summaries)
  return events.map((event) => ({
    params: {slug: event.slug},
    props: {event, otherUpcoming: upcoming.filter((other) => other.slug !== event.slug).slice(0, 2)},
  }))
}) satisfies GetStaticPaths

interface Props {
  event: Event
  otherUpcoming: EventSummary[]
}

const {event, otherUpcoming} = Astro.props
const past = isPast(event.startDate, event.endDate)
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const ogImage = event.image ? urlFor(event.image).width(1200).height(630).fit('crop').url() : undefined
const linkLabel = event.link?.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '')

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.startDate,
  endDate: event.endDate ?? event.startDate,
  description: event.shortDescription,
  image: ogImage,
  url: event.link,
  location:
    event.location?.toLowerCase() === 'online'
      ? {'@type': 'VirtualLocation', url: event.link}
      : {'@type': 'Place', name: event.location, address: event.location},
  organizer: event.organisers ? {'@type': 'Organization', name: event.organisers} : undefined,
}
---

<BaseLayout title={event.title} description={event.shortDescription} image={ogImage} jsonLd={eventJsonLd}>
  <article>
    <header class="event-hero">
      <div class="container">
        <a class="event-hero__back" href="/events">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
          All events
        </a>
        <p class:list={['event-hero__status', {'event-hero__status--past': past}]}>
          {past ? 'Past event' : 'Upcoming event'}
        </p>
        <h1 class="event-hero__title">{event.title}</h1>
        {event.shortDescription && <p class="event-hero__summary">{event.shortDescription}</p>}
      </div>
    </header>

    <div class="container event-layout">
      <aside class="event-details" aria-labelledby="event-details-title">
        <h2 class="visually-hidden" id="event-details-title">Event details</h2>
        <dl class="event-details__list">
          <div class="event-details__row">
            <dt>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path>
              </svg>
              <span class="visually-hidden">Date</span>
            </dt>
            <dd>
              <time datetime={event.startDate}>{formatDateRange(event.startDate, event.endDate)}</time>
            </dd>
          </div>
          {
            event.location && (
              <div class="event-details__row">
                <dt>
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
                    <circle cx="12" cy="9.5" r="2.5" />
                  </svg>
                  <span class="visually-hidden">Location</span>
                </dt>
                <dd>{event.location}</dd>
              </div>
            )
          }
          {
            event.organisers && (
              <div class="event-details__row">
                <dt>
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="9" cy="8" r="3.5" />
                    <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14a6.5 6.5 0 0 1 3.5 6" />
                  </svg>
                  <span class="visually-hidden">Organised by</span>
                </dt>
                <dd>{event.organisers}</dd>
              </div>
            )
          }
          {
            event.link && (
              <div class="event-details__row">
                <dt>
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
                  </svg>
                  <span class="visually-hidden">Website</span>
                </dt>
                <dd>
                  <a href={event.link} target="_blank" rel="noopener noreferrer">
                    {linkLabel}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>

        {
          event.hostLogo && (
            <img
              class="event-details__logo"
              src={urlFor(event.hostLogo).height(112).url()}
              alt={event.hostLogo.alt ?? event.organisers ?? ''}
              height="56"
              loading="lazy"
            />
          )
        }

        <div class="event-details__actions">
          {
            event.link && (
              <a
                class:list={['button', 'event-details__action', {'button--secondary': past}]}
                href={event.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit event website
              </a>
            )
          }
          {
            !past && (
              <a
                class="button button--secondary event-details__action"
                href={calendarFileUrl(event, pageUrl)}
                download={`${event.slug}.ics`}
              >
                Add to calendar
              </a>
            )
          }
        </div>
      </aside>

      <div class="event-content">
        {
          event.image && (
            <img
              class="event-content__image"
              src={urlFor(event.image).width(1200).height(675).fit('crop').url()}
              srcset={srcSet(event.image, [600, 900, 1200, 1600], 16 / 9)}
              sizes="(max-width: 899px) 100vw, 720px"
              alt={event.image.alt ?? ''}
              decoding="async"
            />
          )
        }

        {
          event.description && (
            <section class="event-content__section" aria-labelledby="about-the-event">
              <h2 class="event-content__heading" id="about-the-event">
                About the event
              </h2>
              <RichText value={event.description} />
            </section>
          )
        }

        {
          event.report && (
            <section class="event-report" aria-labelledby="event-report">
              <p class="event-report__label">After the event</p>
              <h2 class="event-content__heading" id="event-report">
                Event report
              </h2>
              <RichText value={event.report} />
            </section>
          )
        }
      </div>
    </div>

    {
      otherUpcoming.length > 0 && (
        <section class="section section--alt" aria-labelledby="other-events">
          <div class="container">
            <div class="other-events__header">
              <h2 class="other-events__title" id="other-events">
                Other upcoming events
              </h2>
              <a class="link-arrow" href="/events">
                All events
              </a>
            </div>
            <EventList events={otherUpcoming} />
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .icon {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Header band */
  .event-hero {
    padding-block: var(--space-l) var(--space-xl);
    background: var(--color-brand-dark);
    color: var(--color-text-inverse);
  }

  .event-hero .container {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
  }

  .event-hero__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xs);
    color: rgb(255 255 255 / 85%);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .event-hero__back:hover {
    color: var(--color-text-inverse);
    text-decoration: underline;
  }

  .event-hero__back .icon {
    width: 16px;
    height: 16px;
  }

  .event-hero__status {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-brand);
    color: var(--color-brand-dark);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .event-hero__status--past {
    background: rgb(255 255 255 / 18%);
    color: var(--color-text-inverse);
  }

  .event-hero__title {
    max-width: 22em;
    font-size: clamp(1.875rem, 4.5vw, 3rem);
    line-height: 1.15;
  }

  .event-hero__summary {
    max-width: 44rem;
    color: rgb(255 255 255 / 88%);
    font-size: clamp(1rem, 1.8vw, 1.1875rem);
  }

  /* Body: content beside a sticky details panel */
  .event-layout {
    display: grid;
    grid-template-areas: 'content details';
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: start;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .event-details {
    position: sticky;
    top: var(--space-m);
    grid-area: details;
    display: grid;
    gap: var(--space-m);
    margin-top: calc(-1 * var(--space-2xl));
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .event-details__list {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .event-details__row {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: var(--space-s);
    align-items: start;
  }

  .event-details__row dt {
    padding-top: 2px;
    color: var(--color-brand);
  }

  .event-details__row dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .event-details__logo {
    width: auto;
    max-width: 160px;
    height: 56px;
    object-fit: contain;
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    box-sizing: content-box;
  }

  .event-details__actions {
    display: grid;
    gap: var(--space-xs);
  }

  .event-details__action {
    text-align: center;
  }

  .button--secondary {
    border: 1px solid var(--color-brand-dark);
    background: var(--color-surface);
    color: var(--color-brand-dark);
  }

  .button--secondary:hover {
    background: var(--color-surface-alt);
  }

  .event-content {
    grid-area: content;
    display: grid;
    gap: var(--space-xl);
    min-width: 0;
  }

  .event-content__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-l);
  }

  .event-content__section,
  .event-report {
    max-width: 68ch;
  }

  .event-content__heading {
    margin-bottom: var(--space-s);
    color: var(--color-brand-dark);
    font-size: 1.5rem;
  }

  .event-report {
    padding: var(--space-l);
    border-left: 4px solid var(--color-brand);
    background: var(--color-surface-alt);
  }

  .event-report__label {
    margin-bottom: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Other upcoming events */
  .other-events__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }

  .other-events__title {
    color: var(--color-brand-dark);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  /* Narrow screens: details come first, straight under the header */
  @media (max-width: 899px) {
    .event-layout {
      grid-template-areas: 'details' 'content';
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }

    .event-details {
      position: static;
      margin-top: calc(-1 * var(--space-l));
    }
  }
</style>
