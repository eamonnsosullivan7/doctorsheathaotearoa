---
import {Image} from 'astro:assets'
import connectionsImage from '../assets/images/AdobeStock_560072776-1.jpeg'
import advocacyImage from '../assets/images/dha-advocacy.jpeg'
import kiwiImage from '../assets/images/kiwi.jpg'
import educationImage from '../assets/images/national-cancer-institute-NFvdKIhxYlU-unsplash-1.jpg'
import PageHero from '../components/PageHero.astro'
import RichText from '../components/RichText.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import {urlFor} from '../sanity/lib/image'
import {getTeam} from '../sanity/lib/queries'

const team = await getTeam()

const pillars = [
  {
    id: 'connections',
    title: 'Connections',
    image: connectionsImage,
    objectives: [
      'Build partnerships with organisations that share our vision for enhancing doctors wellbeing to support them in their personal and professional lives.',
      'Enable doctors to connect with one another and access tailored solutions for their unique challenges.',
      'Facilitating peer support and linking doctors with assessment and treatment options.',
    ],
  },
  {
    id: 'advocacy',
    title: 'Advocacy',
    image: advocacyImage,
    objectives: [
      'Be a leading voice on the systemic issues impacting doctor’s mental, physical and emotional health.',
      "Advocate for reforms that improve working conditions, support systems, and healthcare standards for doctors by engaging with media, regulatory bodies, and professional organisations to ensure doctors' needs are prioritized in public and policy discussions.",
    ],
  },
  {
    id: 'education',
    title: 'Education',
    image: educationImage,
    objectives: [
      "Foster a supportive culture within the medical community that confronts the stigma surrounding doctors' health needs and empowering them to prioritize their wellbeing.",
      'Raise awareness of various resources, workshops and support services, that provide doctors with the knowledge and skills to address critical issues impacting their lives.',
    ],
  },
]
---

<BaseLayout title="About" description="Our mission, history and the team behind Doctors Health Aotearoa.">
  <PageHero
    id="mission"
    title="About Us"
    lead="Our mission is to improve the health and wellbeing of doctors and medical students for the good of all New Zealanders."
  />

  <section class="section" aria-labelledby="pillars-title">
    <div class="container">
      <header class="pillars-header">
        <h2 class="pillars-header__title" id="pillars-title">How we work</h2>
        <p class="pillars-header__intro">Three pillars guide everything we do.</p>
      </header>
      <ul class="pillars" role="list">
        {
          pillars.map((pillar) => (
            <li class={`pillar-card pillar-card--${pillar.id}`} id={pillar.id} data-reveal>
              <Image
                class="pillar-card__image"
                src={pillar.image}
                alt=""
                widths={[400, 720]}
                sizes="(max-width: 699px) 90vw, (max-width: 999px) 45vw, 360px"
              />
              <div class="pillar-card__body">
                <h3 class="pillar-card__title">{pillar.title}</h3>
                <p class="pillar-card__label">Our objectives</p>
                <ul class="pillar-card__objectives">
                  {pillar.objectives.map((objective) => (
                    <li>{objective}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="history" aria-labelledby="history-title">
    <div class="container history">
      <div class="history__text">
        <p class="eyebrow">Our History</p>
        <h2 class="history__title" id="history-title">Doctors Health Aotearoa</h2>
        <p>
          The Doctors Health Advisory Service (DHAS) was founded in response to a recognised need for dedicated support
          services for doctors seeking guidance during challenging times. For over 30 years, DHAS has been at the forefront
          of addressing the psychological and addiction-related challenges faced by doctors.
        </p>
        <p>
          Initially led by Dr Robert Crawford and Dr Edwin Whiteside, DHAS originally operated as an 0800 helpline, with a
          network of skilled clinicians offering early assessments, advice, and referrals. Through this network the
          organisation has supported thousands of practitioners.
        </p>
        <p>
          Through presentations at medical schools and conferences, DHAS actively encouraged doctors, both practicing and
          future, to prioritize their health and well-being.
        </p>
        <p>
          In 2018, DHAS received a generous bequest from Dr Garry Seifert-Jones, a former beneficiary of its services. This
          enabled the establishment of the Doctors Health Advisory Charitable Trust. This expansion marked a shift toward a
          more comprehensive, preventative, and educational approach, broadening DHAS’s reach beyond individual helpline
          services.
        </p>
        <p>
          As of 2024, the Doctors' Health Advisory Service has rebranded as Doctors Health Aotearoa (DHA), focusing on three
          core pillars: <strong>connection, advocacy, and education</strong>. It is New Zealand's only independent umbrella
          organisation for doctors and medical students, and remains steadfast in its commitment to supporting the sector.
        </p>
      </div>
      <Image class="history__image" src={kiwiImage} alt="Kiwi crossing road sign" widths={[400, 800]} sizes="(max-width: 900px) 90vw, 400px" />
    </div>
  </section>

  <section class="section" id="team" aria-labelledby="team-title">
    <div class="container">
      <h2 class="team__title" id="team-title">Meet Our Team</h2>
      <ul class="team" role="list">
        {
          team.map((member) => (
            <li class="team-member" data-reveal>
              <div class="team-member__text">
                <h3 class="team-member__name">{member.name}</h3>
                {member.role && <p class="team-member__role">{member.role}</p>}
                <RichText class="team-member__bio" value={member.bio} />
              </div>
              {member.photo && (
                <img
                  class="team-member__photo"
                  src={urlFor(member.photo).width(600).height(800).fit('crop').url()}
                  alt={member.photo.alt ?? member.name}
                  width="300"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Pillars: image, colour bar matching the homepage diagram, then objectives */
  .pillars-header {
    margin-bottom: var(--space-l);
    text-align: center;
  }

  .pillars-header__title {
    color: var(--color-brand-dark);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .pillars-header__intro {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar-card {
    --pillar-colour: var(--color-pillar-connections);

    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    scroll-margin-top: var(--space-l);
  }

  .pillar-card--advocacy {
    --pillar-colour: var(--color-pillar-advocacy);
  }

  .pillar-card--education {
    --pillar-colour: var(--color-pillar-education);
  }

  /* Arriving from the homepage diagram (/about#advocacy) briefly marks the card. */
  .pillar-card:target {
    outline: 3px solid var(--pillar-colour);
    outline-offset: 3px;
  }

  .pillar-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 6px solid var(--pillar-colour);
  }

  .pillar-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-m);
  }

  .pillar-card__title {
    color: var(--color-brand-dark);
    font-size: 1.5rem;
  }

  .pillar-card__label {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .pillar-card__objectives {
    display: grid;
    gap: var(--space-s);
    margin: var(--space-xs) 0 0;
    padding-left: 1.2em;
  }

  .pillar-card__objectives li::marker {
    color: var(--pillar-colour);
  }

  /* History */
  .history {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .history__text {
    display: grid;
    flex: 1;
    gap: var(--space-s);
    color: var(--color-text-muted);
  }

  .history__title {
    color: var(--color-brand-dark);
    font-size: 1.5rem;
  }

  .history__image {
    flex: 0 1 400px;
    border-radius: var(--radius-m);
  }

  @media (max-width: 900px) {
    .history {
      flex-direction: column;
    }
  }

  /* Team */
  .team__title {
    text-align: center;
  }

  .team {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-member {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border-strong);
  }

  .team-member__text {
    flex: 1;
  }

  .team-member__name {
    font-size: 1.25rem;
  }

  .team-member__role {
    margin-bottom: var(--space-s);
    font-size: 1.125rem;
  }

  .team-member__photo {
    width: 300px;
    max-width: 35%;
    height: 400px;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .team-member {
      flex-direction: column-reverse;
      align-items: flex-start;
    }

    .team-member__photo {
      max-width: 100%;
      height: auto;
      aspect-ratio: 3 / 4;
    }
  }
</style>
