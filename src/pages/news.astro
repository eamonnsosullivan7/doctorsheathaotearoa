---
import {Image} from 'astro:assets'
import newspaperIcon from '../assets/icons/newspaper-icon.svg'
import PageHero from '../components/PageHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import {formatDate} from '../lib/dates'
import {urlFor} from '../sanity/lib/image'
import {getNews} from '../sanity/lib/queries'

const [featured, ...latest] = await getNews()
---

<BaseLayout title="News" description="News and newsletters on doctor health and wellbeing.">
  <PageHero title="News" />

  <div class="section container container--narrow news">
    {
      featured ? (
        <section aria-labelledby="featured-title">
          <h2 class="news__label" id="featured-title">
            Featured
          </h2>
          <article class="article-card article-card--featured">
            <div class="article-card__media">
              {featured.image ? (
                <img
                  class="article-card__image"
                  src={urlFor(featured.image).width(800).height(800).fit('crop').url()}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <Image class="article-card__placeholder" src={newspaperIcon} alt="" width={64} height={64} />
              )}
            </div>
            <div class="article-card__content">
              <time class="article-card__badge" datetime={featured.date}>
                {formatDate(featured.date)}
              </time>
              <h3 class="article-card__title">{featured.title}</h3>
              {featured.subtitle && <p class="article-card__subtitle">{featured.subtitle}</p>}
              {featured.summary && <p class="article-card__summary">{featured.summary}</p>}
              {featured.link && (
                <a class="article-card__link" href={featured.link} target="_blank" rel="noopener noreferrer">
                  Read full article →
                </a>
              )}
            </div>
          </article>
        </section>
      ) : (
        <p>No news yet – check back soon.</p>
      )
    }

    {
      latest.length > 0 && (
        <section class="news__latest" aria-labelledby="latest-title">
          <h2 class="news__label" id="latest-title">
            Latest news
          </h2>
          <ul class="news__grid" role="list">
            {latest.map((item) => (
              <li>
                <article class="article-card">
                  <div class="article-card__media">
                    {item.image ? (
                      <img
                        class="article-card__image"
                        src={urlFor(item.image).width(800).height(450).fit('crop').url()}
                        alt=""
                        loading="lazy"
                      />
                    ) : (
                      <Image class="article-card__placeholder" src={newspaperIcon} alt="" width={48} height={48} />
                    )}
                  </div>
                  <div class="article-card__content">
                    <time class="article-card__badge" datetime={item.date}>
                      {formatDate(item.date)}
                    </time>
                    <h3 class="article-card__title">{item.title}</h3>
                    {item.subtitle && <p class="article-card__subtitle">{item.subtitle}</p>}
                    {item.summary && <p class="article-card__summary article-card__summary--clamped">{item.summary}</p>}
                    {item.link && (
                      <a class="article-card__link" href={item.link} target="_blank" rel="noopener noreferrer">
                        Read full article →
                      </a>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .news__label {
    margin-bottom: var(--space-s);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .news__latest {
    margin-top: var(--space-2xl);
  }

  .news__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
  }

  .article-card--featured {
    flex-direction: row;
    border-radius: var(--radius-l);
  }

  .article-card__media {
    display: grid;
    place-items: center;
    min-height: 180px;
    background: var(--color-brand-light);
  }

  .article-card--featured .article-card__media {
    flex: 0 0 40%;
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__placeholder {
    opacity: 0.5;
  }

  .article-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-m);
  }

  .article-card__badge {
    padding: 2px 8px;
    border-radius: var(--radius-s);
    background: var(--color-brand-dark);
    color: var(--color-text-inverse);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .article-card__title {
    font-size: 1.25rem;
  }

  .article-card__subtitle {
    color: var(--color-text-muted);
  }

  .article-card__summary {
    font-size: 0.875rem;
  }

  .article-card__summary--clamped {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }

  .article-card__link {
    margin-top: auto;
    padding-top: var(--space-xs);
    font-size: 0.875rem;
  }

  @media (max-width: 767px) {
    .article-card--featured {
      flex-direction: column;
    }
  }
</style>
