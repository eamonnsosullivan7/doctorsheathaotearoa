---
interface Props {
  title: string
  /** Optional sentence shown under the title, e.g. a mission statement. */
  lead?: string
  id?: string
}

const {title, lead, id} = Astro.props
---

<section class:list={['page-hero', {'page-hero--with-lead': lead}]} id={id}>
  <div class="container">
    <h1 class="page-hero__title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-xl);
    background: var(--color-brand-dark);
    color: var(--color-text-inverse);
    text-align: center;
    clip-path: ellipse(70% 100% at 50% 0);
  }

  /* Extra room at the bottom keeps the lead clear of the curved edge. */
  .page-hero--with-lead {
    padding-bottom: var(--space-2xl);
  }

  .page-hero__title {
    font-size: var(--font-size-page-title);
    font-weight: var(--font-weight-extrabold);
  }

  .page-hero__lead {
    max-width: 40rem;
    margin: var(--space-s) auto 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--font-size-lead);
    line-height: 1.5;
  }
</style>
