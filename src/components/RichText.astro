---
import type {PortableTextBlock} from '@portabletext/types'
import {PortableText} from 'astro-portabletext'
import Link from './portable-text/Link.astro'

interface Props {
  value?: PortableTextBlock[]
  class?: string
}

const {value, class: className} = Astro.props
const components = {mark: {link: Link}}
---

{
  value?.length ? (
    <div class:list={['rich-text', className]}>
      <PortableText value={value} components={components} />
    </div>
  ) : null
}

<style>
  .rich-text {
    overflow-wrap: anywhere;
  }

  .rich-text :global(> * + *) {
    margin-top: 0.75em;
  }

  .rich-text :global(h3),
  .rich-text :global(h4) {
    margin-top: 1.5em;
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 0;
  }

  .rich-text :global(li + li) {
    margin-top: 0.25em;
  }

  .rich-text :global(blockquote) {
    margin-inline: 0;
    padding-left: 1em;
    border-left: 3px solid var(--color-brand);
  }
</style>
