---
import {formatDateRange, isPast} from '../lib/dates'
import type {EventSummary} from '../sanity/lib/queries'
import {srcSet, urlFor} from '../sanity/lib/image'

interface Props {
  event: EventSummary
  /** Image beside the details on wider screens. */
  wide?: boolean
  /** The next upcoming event: wide, with a "Next event" label. */
  featured?: boolean
}

const {event, featured = false} = Astro.props
const wide = featured || Astro.props.wide
const href = `/event/${event.slug}`
const past = isPast(event.startDate, event.endDate)
---

<article class:list={['event-card', {'event-card--wide': wide}]} data-reveal>
  <div class="event-card__media">
    {
      event.image && (
        <img
          class="event-card__image"
          src={urlFor(event.image).width(800).height(440).fit('crop').url()}
          srcset={srcSet(event.image, [400, 800, 1200], 800 / 440)}
          sizes={wide ? '(max-width: 767px) 100vw, 570px' : '(max-width: 900px) 100vw, 560px'}
          alt=""
          loading={featured ? 'eager' : 'lazy'}
          decoding="async"
        />
      )
    }
    {past && <span class="event-card__badge">Past event</span>}
  </div>

  <div class="event-card__body">
    {featured && <p class="event-card__label">Next event</p>}
    <header class="event-card__header">
      <div>
        <h3 class="event-card__title">
          <a class="event-card__title-link" href={href}>{event.title}</a>
        </h3>
        {event.organisers && <p class="event-card__organisers">{event.organisers}</p>}
      </div>
      {
        event.hostLogo && (
          <img
            class="event-card__logo"
            src={urlFor(event.hostLogo).height(96).url()}
            alt={event.hostLogo.alt ?? ''}
            height="48"
            loading="lazy"
          />
        )
      }
    </header>

    {event.shortDescription && <p class="event-card__description">{event.shortDescription}</p>}

    <footer class="event-card__footer">
      <dl class="event-card__meta">
        {
          event.location && (
            <div>
              <dt class="visually-hidden">Location</dt>
              <dd>{event.location}</dd>
            </div>
          )
        }
        <div>
          <dt class="visually-hidden">Date</dt>
          <dd>
            <time datetime={event.startDate}>{formatDateRange(event.startDate, event.endDate)}</time>
          </dd>
        </div>
      </dl>
      <a class="button" href={href} aria-hidden="true" tabindex="-1">Learn more</a>
    </footer>
  </div>
</article>

<style>
  .event-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .event-card__media {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: var(--color-brand-light);
  }

  .event-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-card__badge {
    position: absolute;
    right: -38px;
    bottom: 25px;
    padding: 8px 40px;
    background: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    transform: rotate(-45deg);
  }

  .event-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-s);
  }

  .event-card__header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .event-card__title {
    font-size: 1rem;
    line-height: 1.5;
  }

  .event-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  /* Make the whole card clickable via the title link. */
  .event-card__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .event-card__title-link:focus-visible {
    outline: none;
  }

  .event-card:has(.event-card__title-link:focus-visible) {
    outline: 0.125rem solid var(--color-focus);
    outline-offset: 0.125rem;
  }

  .event-card__organisers {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .event-card__logo {
    width: auto;
    max-width: 120px;
    height: 48px;
    object-fit: contain;
  }

  .event-card__description {
    color: var(--color-brand-dark);
  }

  .event-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: auto;
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
  }

  .event-card__meta {
    margin: 0;
    font-size: 0.875rem;
  }

  .event-card__meta dd {
    margin: 0;
  }

  .event-card:hover .button {
    background: #133654;
  }

  /* Wide: image beside the details on wider screens. */
  .event-card__label {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-brand-light);
    color: var(--color-brand-dark);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .event-card--wide .event-card__title {
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    line-height: 1.3;
  }

  .event-card--wide .event-card__description {
    font-size: 1.0625rem;
  }

  .event-card--wide .event-card__meta {
    font-size: 1rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .event-card--wide {
      flex-direction: row;
      min-height: 340px;
    }

    .event-card--wide .event-card__media {
      flex: 0 0 50%;
      height: auto;
    }

    .event-card--wide .event-card__body {
      gap: var(--space-m);
      padding: var(--space-l);
    }
  }
</style>
