---
import type {MarkProps} from 'astro-portabletext/types'

type Props = MarkProps<{href?: string}>

const {node} = Astro.props
const href = node.markDef.href ?? '#'
const isExternal = /^https?:\/\//.test(href) && !/^https?:\/\/(www\.)?doctorshealth\.co\.nz/.test(href)
---

<a href={href} {...isExternal && {target: '_blank', rel: 'noopener noreferrer'}}><slot /></a>
